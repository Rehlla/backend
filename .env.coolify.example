# Coolify runtime environment (copy values into Coolify → Environment Variables).
# Mark secrets as Runtime only. Leave VITE_* available at build time: Vite inlines them.

NODE_ENV=production
PORT=3000

# Public HTTPS URL of the Coolify domain.
APP_URL=https://your-domain.com

# Persistent SQLite. Mount a Coolify volume at /app/data (one instance only).
PERSISTENCE_ADAPTER=sqlite
DAHAB_DATA_DIR=/app/data
DAHAB_SEED_DIR=/app/seed

# Required to create the demo users on an empty database. At least 16 characters.
# Do not use Dahab2026!Secure — boot refuses that committed value.
SEED_USER_PASSWORD=

# Optional. Without a key, AI paths stay on their deterministic answers.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_POLISH_TIMEOUT_MS=6000

# Build-time (not Runtime only). Baked into the client map bundles.
VITE_LOCATIONIQ_MAPS_TOKEN=
VITE_CARTO_MAPS_API_KEY=

# Server-only.
LOCATIONIQ_API_KEY=

# Optional SMS.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Optional payments. PAYMOB_HMAC_SECRET is required before webhooks are accepted.
PAYMOB_API_KEY=
PAYMOB_HMAC_SECRET=

# Keep off in production. This endpoint writes real trips and bookings.
ENABLE_TEST_ENDPOINTS=false

# Leave unset unless you attach Postgres and intend to leave sqlite.
# DATABASE_URL=postgresql://user:password@host:5432/dahab_db
