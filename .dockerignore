# Build inputs only. Anything not needed to run `npm ci && npm run build`
# stays out of the build context.

.git
.github
node_modules
dist
build
coverage

# Secrets and local state. .env holds a live Gemini key; data/ holds session
# tokens, traveler contact details and supplier payout IBANs. The seed datasets
# under data/ ARE needed at boot and are re-admitted below.
.env
.env.*
!.env.example
*.local.md
*.local.json

# Runtime database files only. The seed JSON under data/ is read at boot.
data/*.sqlite
data/*.sqlite-shm
data/*.sqlite-wal
data/*.seq
data/locks
data/backups
data/cms-media
data/payment-receipts
data/daygi_chats.json
data/daygi_beta_telemetry.json
data/daygi_tasks.json
data/audit-archive-*.jsonl

# Documentation. The admin proof route imports server/test at runtime,
# so that directory stays in the image.
docs

.claude
.vscode
.idea
*.log
