# OPENAI_API_KEY: Required for every AI call (DayGI phrasing + clarification,
# search-intent parsing, ops intelligence, trip generation).
# Optional: with no key every AI path falls back to its deterministic answer and
# the product stays fully usable. Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY="MY_OPENAI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# LOCATIONIQ_API_KEY: Optional reverse-geocoding for the "From anywhere in
# Egypt" transfer tab. Turns the browser's lat/lng into a readable city so the
# hub can show "Detected: Cairo" and price from the nearest served origin.
# Server-side only — never shipped to the browser. Unset/failure falls back to
# nearest-origin matching without a detected label.
LOCATIONIQ_API_KEY=

# VITE_LOCATIONIQ_MAPS_TOKEN: Optional — powers the map on /hotels
# (accommodations search). Unlike LOCATIONIQ_API_KEY above, this one IS
# shipped to the browser on purpose: LocationIQ's Maps/tile product is meant
# to be used client-side (like a Mapbox public token), and is rate-limited by
# domain/referrer restriction configured in LocationIQ's own dashboard rather
# than by secrecy. Can reuse the same account token as LOCATIONIQ_API_KEY.
# Unset falls back to public OpenStreetMap demo tiles (fine for local dev,
# not for production traffic — OSM's usage policy is for light use only).
VITE_LOCATIONIQ_MAPS_TOKEN=

# VITE_CARTO_MAPS_API_KEY: Powers the Leaflet basemaps (DayGI plan canvas and
# the /hotels map). CARTO has required a key on raster tiles since Sep 2026 —
# without one every tile renders an "API KEY REQUIRED" notice instead of the
# map. Free at carto.com/basemaps/apikey (no account); public by design like a
# Mapbox public token, so protect it with HTTP-referrer restrictions in the
# CARTO dashboard. The dashboard treats localhost/127.0.0.1 as a separate
# host — local dev needs its own allowances or its own key.
VITE_CARTO_MAPS_API_KEY=

# TWILIO SMS GATEWAY (Optional: For live SMS dispatch to drivers and dive centers)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# OPENAI_MODEL: Model id used for every AI call.
# Defaults to gpt-4o-mini in the server code — cheap and fast enough for the
# classification and JSON-shaping work here. Use a stronger model (gpt-4o) only
# if the phrasing polish is worth its latency.
OPENAI_MODEL=gpt-4o-mini

# AI_POLISH_TIMEOUT_MS: How long the DayGI phrasing polish may take before the
# deterministic answer is returned instead. The polish is a nicety; it must
# never hold an already-complete answer hostage. (Previously
# GEMINI_POLISH_TIMEOUT_MS, default 6000.)
AI_POLISH_TIMEOUT_MS=6000

# SKIP_AI_POLISH: Set to 'true' to answer every DayGI turn deterministically,
# with no model call at all. Useful for load tests and offline work.
# (Previously SKIP_GEMINI_POLISH.)
# SKIP_AI_POLISH=true

# PAYMOB EGYPT PAYMENT GATEWAY (Optional: For live merchant card & wallet settlement)
# PAYMOB_HMAC_SECRET is REQUIRED to accept webhooks. There is deliberately no
# fallback value: without it, every webhook is rejected rather than trusted.
PAYMOB_API_KEY=
PAYMOB_HMAC_SECRET=

# SEED_USER_PASSWORD: Required to seed the demo Traveler/Supplier/Operations/Admin
# accounts on a boot with an empty user table. If unset, NO users are seeded.
# Never commit a real value here.
# Must be at least 16 characters, and must not be 'Dahab2026!Secure' — that
# value was committed to this repository and boot refuses it by name.
SEED_USER_PASSWORD=

# SCRAPEGRAPH_API_KEY: Optional — enables AI-powered structured data extraction
# from travel websites (hotel prices, reviews, activity details). Used by
# server/services/scrapeGraphService.ts and scripts/scrapegraph-fetch.ts.
# Without it the service is disabled and all other features work normally.
# Get a key at https://scrapegraphai.com/
SCRAPEGRAPH_API_KEY=

# SCRAPEGRAPH_SCHEDULER_ENABLED: Set to "true" to start the periodic price
# fetch job (default: 6 hours). When disabled the service is still available
# via POST /api/admin/scrape-graph/run (admin-only). Requires SCRAPEGRAPH_API_KEY.
# SCRAPEGRAPH_SCHEDULER_ENABLED=true

# SCRAPEGRAPH_SCHEDULER_INTERVAL_MS: Override the default 6-hour interval.
# SCRAPEGRAPH_SCHEDULER_INTERVAL_MS=21600000

# ENABLE_TEST_ENDPOINTS: Set to "true" to expose POST /api/testing/golden-journey.
# That endpoint writes real trips, bookings and ledger entries, so keep it off
# anywhere that holds data you care about.
ENABLE_TEST_ENDPOINTS=false

# DATABASE & PERSISTENCE
#
#   sqlite   (default) data/dahab.sqlite via better-sqlite3. A real local
#            database: WAL, enforced foreign keys, unique constraints, indexes,
#            and per-row writes instead of rewriting the whole store. Needs no
#            server process. Create it with `npm run db:migrate`.
#
#   json     The previous single-file store, data/dahab_db.json. Still supported
#            for tests and as a rollback. It cannot enforce a constraint and
#            rewrites the entire file on every mutation.
#
#   postgres via PostgresPersistenceAdapter (shadow-diff flush to spec-generated schema, DATABASE_URL/PG* required, checksum-guarded migrations, lastSaveError in /api/health) — real persistence via pgFlush.ts + saveChain (PostgresPersistenceAdapter.ts:227). Not yet certified against a live instance — do not flip the default.
#
# Selecting sqlite when data/dahab.sqlite is missing but data/dahab_db.json
# exists is refused, rather than silently starting on an empty database while
# the real one sits unread beside it.
PERSISTENCE_ADAPTER=sqlite

# Read by postgres adapter for real persistence (plus migrateFromJson() and
# DDL in server/db/sql/schema.sql).
DATABASE_URL=postgresql://postgres:password@localhost:5432/dahab_db

# ── INTEGRATIONS: WhatsApp transport (OpenWA) + dispatch console (FleetBase) ──
# Both services run from integrations/ (see integrations/README.md). The keys
# below are what THIS backend needs; each service keeps its own .env next to its
# compose file. Nothing here is read by the services themselves.

# OpenWA — WhatsApp transport. OPENWA_ENABLED=false keeps every WhatsApp send
# SIMULATED (recorded, never claimed as sent) — the production default until a
# number is linked and verified.
OPENWA_ENABLED=false
OPENWA_BASE_URL=http://127.0.0.1:2785
OPENWA_API_KEY=
# Session used when a message has no purpose-specific default linked yet.
OPENWA_SESSION_ID=pilot
# HMAC secret OpenWA signs inbound webhooks with; must match
# integrations/openwa/.env OPENWA_WEBHOOK_SECRET.
OPENWA_WEBHOOK_SECRET=
# Phone the first seeded session is created from (moved into the DB once linked).
WHATSAPP_DEFAULT_NUMBER=01011985293
WHATSAPP_DEFAULT_PURPOSE=traveler

# FleetBase — dispatch console (rides only: orders, drivers, vehicles, tracking).
# Our backend stays the source of truth for money, holds and pricing; FleetBase
# gets a read-model and its webhooks come back through /api/webhooks/fleetbase.
FLEETBASE_ENABLED=false
FLEETBASE_BASE_URL=http://127.0.0.1:8000
FLEETBASE_API_KEY=
FLEETBASE_WEBHOOK_SECRET=
