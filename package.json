{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "dev:fresh": "node -e \"require('fs').rmSync('node_modules/.vite', { recursive: true, force: true })\" && tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --define:process.env.NODE_ENV=\"'production'\" --outfile=dist/server.cjs && tsx scripts/grpc/copyProtos.ts",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "i18n:emit": "tsx scripts/i18n/emitDictionaries.ts --write && tsx scripts/i18n/emitDictionaries.ts",
    "test": "vitest run && vitest run --config vitest.ui.config.ts",
    "test:watch": "vitest",
    "test:ui": "vitest run --config vitest.ui.config.ts",
    "test:e2e": "playwright test",
    "db:migrate": "tsx server/db/sqlite/migrateJsonToSqlite.ts",
    "db:migrate:dry": "tsx server/db/sqlite/migrateJsonToSqlite.ts --dry-run",
    "db:migrate:quarantine": "tsx server/db/sqlite/migrateJsonToSqlite.ts --quarantine --force",
    "db:check": "tsx server/db/sqlite/checkIntegrity.ts",
    "db:backup": "tsx server/db/sqlite/backup.ts",
    "db:schema": "tsx server/db/sqlite/emitSchema.ts",
    "db:schema:pg": "tsx server/db/postgres/emitPostgresSchema.ts",
    "db:research": "tsx server/db/research/importResearch.ts",
    "db:research:apply": "tsx server/db/research/importResearch.ts --apply",
    "db:add-nav-tabs": "tsx server/db/sqlite/addNavTabs.ts",
    "openapi:gen": "tsx scripts/gen-openapi.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@graphql-tools/schema": "^10.1.5",
    "@grpc/grpc-js": "^1.14.6",
    "@grpc/proto-loader": "^0.8.1",
    "@mediapipe/tasks-vision": "^1.0.1",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-switch": "^1.3.7",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "date-fns": "^4.4.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "graphql": "^17.0.2",
    "helmet": "^8.3.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.7.0",
    "vite": "^6.2.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "jsdom": "^28.1.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.11"
  }
}
